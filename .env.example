# Interactive Brokers login. Paper and live trading use the same credentials;
# TRADING_MODE in docker-compose.yml (currently "paper") picks which account
# ib-gateway connects to. IB_ACCOUNT is your account ID ("DU..." for paper).
IB_USER=
IB_PASSWORD=
IB_ACCOUNT=

# https://www.marketaux.com/ — free tier is enough for development.
MARKETAUX_API_TOKEN=

# Optional: only needed if you want Discord alerts, commands and the live
# dashboard. The trading loop itself runs fine without these set.
# DISCORD_TOKEN is the bot token from the Discord Developer Portal.
# DISCORD_CHANNEL_ID is the channel it posts alerts and the dashboard to
# (right-click the channel → Copy Channel ID; Developer Mode must be on).
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
